 PATH=/usr/sbin:/usr/bin:/sbin:/bin
 CONFIG=tr3600-fan.main
 
+# Hysteresis of the seasonal curves, in millidegrees.  Matches the
+# hysteresis of the trips in the board DTS.
+SEASON_HYST=5000
+
+# Idle baseline file: the lowest temperature seen while the fan was stopped.
+# LuCI reads it to make its seasonal suggestion.
+IDLE_FILE=/tmp/tr3600-fan.idle
+
+# How much the idle baseline drifts upwards per 10 s tick (millidegrees).
+# 10 mC / 10 s = 3.6 C/hour: when the fan never stops (i.e. it is hot) the
+# baseline slowly walks up towards the measured temperature instead of
+# staying frozen at a stale winter value.
+IDLE_DECAY=10
+
 fan_cdev() {
 	for c in /sys/class/thermal/cooling_device*; do
 		[ -r "$c/type" ] || continue
@@ -80,6 +94,79 @@
 	uci -q get "$CONFIG.level" 2>/dev/null || echo 2
 }
 
+config_season() {
+	uci -q get "$CONFIG.season" 2>/dev/null || echo auto
+}
+
+# The three seasonal curves, as "level1 level2 level3" trip temperatures in
+# millidegrees (50 % / 78 % / 100 % PWM).  The fan stops again 5 C below the
+# level-1 trip, which is what keeps it silent at idle.
+#
+#   winter : this board idles at ~64 C, so the fan stays completely stopped
+#            at idle and only spins up under real load.
+#   mild   : starts 2 C earlier, for a slightly warmer room.  It MUST stay
+#            above the measured fan-stopped idle temperature (64.1 C), or
+#            the fan would never release and would hum at idle forever -
+#            which is the exact bug this package exists to avoid.
+#   summer : starts 10 C earlier, so a hot room is actively cooled down
+#            instead of just being kept at the edge of the trip.
+season_trips() {
+	case "$1" in
+	winter) echo "68000 78000 88000" ;;
+	mild)   echo "66000 76000 86000" ;;
+	summer) echo "58000 68000 78000" ;;
+	*)      echo "68000 78000 88000" ;;
+	esac
+}
+
+# Calendar season (northern hemisphere).  Deliberately NOT based on the live
+# temperature: load pushes the temperature up, so a temperature-driven
+# automatic switch flaps between seasons whenever the router gets busy.
+# The temperature is used by the LuCI page to refine its *suggestion*
+# instead, where a human decides.
+calendar_season() {
+	case "$(date +%m 2>/dev/null)" in
+	06|07|08) echo summer ;;
+	12|01|02) echo winter ;;
+	*) echo mild ;;
+	esac
+}
+
+effective_season() {
+	local s
+	s="$(config_season)"
+	[ "$s" = auto ] && s="$(calendar_season)"
+	echo "$s"
+}
+
+# Pick the fan level for the current temperature, honouring hysteresis so
+# the fan does not chatter around a trip point.
+smart_level() {
+	local temp="$1" prev="$2"
+	local t1 t2 t3 new
+
+	set -- $(season_trips "$(effective_season)")
+	t1="$1"
+	t2="$2"
+	t3="$3"
+
+	new=0
+	[ "$temp" -ge "$t1" ] 2>/dev/null && new=1
+	[ "$temp" -ge "$t2" ] 2>/dev/null && new=2
+	[ "$temp" -ge "$t3" ] 2>/dev/null && new=3
+
+	# Going down a level requires dropping below "this level's trip - hysteresis".
+	if [ "$new" -lt "$prev" ]; then
+		case "$prev" in
+		1) [ "$temp" -ge $((t1 - SEASON_HYST)) ] 2>/dev/null && new=1 ;;
+		2) [ "$temp" -ge $((t2 - SEASON_HYST)) ] 2>/dev/null && new=2 ;;
+		3) [ "$temp" -ge $((t3 - SEASON_HYST)) ] 2>/dev/null && new=3 ;;
+		esac
+	fi
+
+	echo "$new"
+}

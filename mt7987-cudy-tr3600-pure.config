# Cudy TR3600 v1 (MT7987B) — OpenWrt 精簡 + 性能優化版（目前唯一的建置線）
#
# 設計目標：
#   * 只保留 OpenWrt 原生基底 + 硬體支援
#   * 只保留一個外掛：TR3600 智能風扇插件
#   * 主題用 OpenWrt 原生 bootstrap
#   * 移除所有商店 / 科學上網 / DNS / 第三方主題 / 工具類外掛
#   * 風扇與 WiFi 的板級修正全部由 patches/ 0001~0007 打進 DTS 與 mt76
#
# 2026-10-13：iStore 應用商店移除（連同 linkease/istore feed），
#   iStore 版建置線（build-openwrt-iStore.yml / mt7987-cudy-tr3600-iStore.config）
#   整個退休，本檔成為唯一的 config。
#   - 移除 iStore：luci-app-store / luci-i18n-store-zh-cn / luci-lib-taskd /
#     luci-lib-xterm / xz-utils
#   - 移除 Passwall / Passwall2 / OpenClash / SSR+ / Nikki / Momo / Daed
#   - 移除 mosdns / smartdns / EasyTier / Tailscale / OpenList / rtp2httpd
#   - 移除 luci-app-ttyd / filemanager / authshield / watchdog / taskplan
#   - 移除 Argon / Aurora / Kucat 主題與其設定頁
#   - 移除 miniupnpd
#   - 新增 net.core.default_qdisc=fq + tcp_congestion_control=bbr（見 diy-pure-part2.sh）

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
#######################################################################
#                            DEVICES                                  #
#######################################################################
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_tr3600-v1=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_cudy_tr3600-v1=""
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AFALG_UPDATE_CTR_IV=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
# CONFIG_GDB is not set
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
CONFIG_KERNEL_NET_CLS_CGROUP=y
#######################################################################
#                              KMODS                                  #
#######################################################################
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md4=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_kmod-ebtables-ipv4=y
CONFIG_PACKAGE_kmod-ebtables-ipv6=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-leds-ws2812b=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-lib-lzo=y
# HWNAT：MediaTek 硬體 NAT 加速，2.5G WAN 跑滿的關鍵
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-sched-core=y
# sch_fq（Fair Queue）—— 2026-10-13 補上
#   kmod-sched-core 只含 sch_ingress/sch_hfsc/sch_htb/sch_tbf，**不含 sch_fq**。
#   sch_fq 在另一個套件 kmod-sched（"Extra traffic schedulers"）。
#   沒有它，net.core.default_qdisc=fq 會直接
#   `sysctl: write error: No such file or directory`（實測），
#   而 kmod-tcp-bbr 的說明自己就寫 "It requires the fq pacing packet scheduler"。
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-scsi-core=y
# BBR：低延遲高吞吐擁塞控制（需要上面的 sch_fq）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
# zram：把壓縮記憶體當 swap，記憶體吃緊時不 OOM
CONFIG_PACKAGE_kmod-zram=y
#######################################################################
#                          WIFI OPTIONS                               #
#######################################################################
# WED 硬體無線卸載（Wireless Ethernet Dispatch）+ RRO
CONFIG_WED_HW_RRO_SUPPORT=y
CONFIG_first_card=y
CONFIG_first_card_name="MT7987"
#######################################################################
#                      BASE PACKAGES（原生基底）                      #
#######################################################################
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_l1util=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_mii-mgr=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtkhqos-util=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ebtables=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo-ucode=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libcap-ng=y
CONFIG_PACKAGE_libcbor=y
CONFIG_PACKAGE_libevdev=y
CONFIG_PACKAGE_libfido2=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnl=y
CONFIG_PACKAGE_libnl-core=y
CONFIG_PACKAGE_libnl-genl=y
CONFIG_PACKAGE_libnl-nf=y
CONFIG_PACKAGE_libnl-route=y
CONFIG_PACKAGE_libopenssl-afalg=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libudev-zero=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_zram-swap=y
#######################################################################
#                              MISC                                   #
#######################################################################
# CONFIG_AFALG_FALLBACK is not set
# CONFIG_PKG_CHECK_FORMAT_SECURITY is not set
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_OPENSSL_ENGINE is not set
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM is not set
CONFIG_OPENSSL_WITH_NPN=y
# NLS 國際化，LuCI 中文必備
CONFIG_BUILD_NLS=y
CONFIG_PACKAGE_libintl-full=y
CONFIG_PACKAGE_libiconv-full=y
CONFIG_LUCI_LANG_zh_Hans=y
# 中文字型，防止中文方塊亂碼
CONFIG_PACKAGE_ttf-wqy-microhei=y
# =========================================================================
#   iStore 應用商店：2026-10-13 移除
#   連同 feeds.conf.default 的 linkease/istore feed 一起拿掉，所以下列套件
#   不再存在（不列進 config，否則 oldconfig 會抱怨未知符號）：
#     luci-app-store / luci-i18n-store-zh-cn（本體）
#     luci-lib-taskd / luci-lib-xterm（由 istore feed 提供）
#     xz-utils（iStore 專用依賴）
#   保留 luci-i18n-package-manager-zh-cn —— 那是 OpenWrt 內建「軟體套件」頁
#   的中文翻譯（來自官方 luci feed），跟 iStore 無關。
# =========================================================================
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
# =========================================================================
#                外掛 1/1：TR3600 智能風扇插件（內建）
#   套件本體在倉庫 vendor/luci-app-tr3600-fan/，不依賴第三方倉庫
# =========================================================================
CONFIG_PACKAGE_luci-app-tr3600-fan=y
CONFIG_PACKAGE_luci-i18n-tr3600-fan-zh-cn=y
# =========================================================================
#   明確關閉：科學上網 / DNS / 主題 / 工具類外掛
#   就算上游分支把它們塞進 DEFAULT_PACKAGES，這裡的 "is not set" 也會贏。
#   workflow 的 oldconfig 步驟會複查，真的混進來就直接失敗。
# =========================================================================
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-lib-taskd is not set
# CONFIG_PACKAGE_luci-lib-xterm is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_luci-app-momo is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_luci-app-tailscale-community is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set
# CONFIG_PACKAGE_luci-app-openlist is not set
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-filemanager is not set
# CONFIG_PACKAGE_luci-app-authshield is not set
# CONFIG_PACKAGE_luci-app-watchdog is not set
# CONFIG_PACKAGE_luci-app-taskplan is not set
# CONFIG_PACKAGE_luci-app-poweroffdevice is not set
# CONFIG_PACKAGE_luci-app-owq-wol is not set
# CONFIG_PACKAGE_luci-app-openappfilter is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-uhttpd is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-theme-aurora is not set
# CONFIG_PACKAGE_luci-app-aurora-config is not set
# CONFIG_PACKAGE_luci-theme-kucat is not set
# CONFIG_PACKAGE_luci-app-kucat-config is not set
# CONFIG_PACKAGE_miniupnpd is not set
# =========================================================================
#                 介面語言 / 主題（OpenWrt 原生 bootstrap）
# =========================================================================
CONFIG_PACKAGE_luci-i18n-admin-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-theme-bootstrap-zh-cn=y
CONFIG_PACKAGE_default-settings=y
CONFIG_DEFAULT_LANG=zh_Hans
CONFIG_DEFAULT_THEME=bootstrap
# 添加 ubootenv 支持，SSH 讀寫 uboot 環境變數，禁用 nvram 版本
CONFIG_PACKAGE_kmod-ubootenv=y
CONFIG_PACKAGE_uboot-envtools=y
# CONFIG_PACKAGE_kmod-ubootenv-nvram is not set
# hostapd 11BE 開啟配置
# ⚠️ 2026-10-13：wpad-basic-mbedtls → wpad-mbedtls
#   basic 版**缺 802.11r / k / v（快速漫遊）與 WPS**。這台是雙頻 Wi-Fi 7，
#   手機／筆電在 2.4G ↔ 5G 之間、或多 AP 之間移動時，basic 只能靠斷線重連。
#   wpad-mbedtls 用 mbedTLS（比 openssl 版小），功能完整。
#   注意這是**替換**：兩者衝突，不能共存。
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
# =========================================================
# 開源 mt76 無線方案（DTS compatible=mediatek,mt76，MT7990）
# =========================================================
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y

# =========================================================================
#                        USB 支援（2026-10-13 新增）
#
# 背景：這台有 **USB 3.0 埠**（官方規格「双 2.5G 网口 + USB 3.0」）。
#   DTS 的 soc/usb@11200000 = status=okay（compatible=mediatek,mt7987-xhci），
#   kmod-usb3 / kmod-usb-xhci-mtk / kmod-usb-core 本來就已經裝了，
#   xhci_mtk_hcd 有載入、/sys/bus/usb/devices/ 有 usb1/usb2 兩個 root hub。
#
#   **但只有 host controller，沒有任何「裝置類」驅動** ——
#   插隨身碟不會有反應（沒有 usb-storage），插 USB 網卡也不會有反應
#   （沒有 usbnet 及其晶片驅動）。以下就是補這一塊。
#
# ⚠️ 重要前提（2026-10-13 實測）：OpenWrt 的 feed **不發佈任何內核模組**
#   （targets/mediatek/filogic/packages/ 只有 91 個 .apk、0 個 kmod；
#    x86/64、mt7622、連 24.10.0 release 也全是 0）。所以這些**只能編進固件**，
#   之後沒辦法用 apk 補裝。
#
# 所有這些都是 AutoProbe（有插上才載入），不會拖慢開機。
# =========================================================================

# ---- 1. USB 儲存（掛載隨身碟 / 硬碟）----
CONFIG_PACKAGE_kmod-usb-storage=y
# UASP：USB 3.0 硬碟用這個協定快很多（BOT 只能跑到 ~30% 的頻寬）
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# 檔案系統：ext4（Linux 原生）、exfat（大容量隨身碟的事實標準）、ntfs3（Windows 硬碟）
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# （kmod-fs-vfat 上面已經有了）
# 掛載管理：fstab / 熱插拔自動掛載 / LuCI「系統 → 掛載點」
CONFIG_PACKAGE_block-mount=y

# ---- 2. USB 網卡（USB-to-Ethernet）----
# usbnet 核心 + 各家晶片驅動。按「在市面上見到的頻率」排序。
CONFIG_PACKAGE_kmod-usb-net=y
# Realtek RTL8152/8153 —— 最常見的 USB 2.0/3.0 千兆網卡
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
# ASIX AX88179 —— USB 3.0 千兆，第二常見（很多 USB Hub+網卡一體機）
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
# ASIX AX8817x —— USB 2.0 百兆/千兆（舊款）
CONFIG_PACKAGE_kmod-usb-net-asix=y
# Aquantia AQC111 —— USB 5G / 2.5G 網卡（要跑滿 2.5G WAN 就靠它）
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
# Microchip LAN78xx（LAN7800 USB3 千兆）
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
# SMSC LAN95xx —— 很多廉價 USB 網卡 / 一體式 Hub
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
# 其他零散但便宜的
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-sr9700=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y

# ---- 3. USB 共享 / 手機有線網路（tethering）----
# 這些是「手機插上去就變一張網卡」，也算 USB 網卡。
CONFIG_PACKAGE_kmod-usb-net-rndis=y          # Android / Windows 的 RNDIS 共享
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y        # iPhone / 較新 Android / 部分 4G 網卡
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y      # CDC-ECM，Linux 系 / 部分網卡
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y         # iPhone USB 共享

# ---- 4. 4G / 5G 網卡棒（WWAN）----
# 出門在外的備援上網。TR3600 定位是旅行路由器，這條算是「相關」的延伸。
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y       # QMI（Quectel / 華為等主流模組）
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y       # MBIM（較新的模組 / Windows 系）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y      # 模組的 AT 埠
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
# 很多網卡棒一開始會裝成 CD-ROM（內含驅動），要 modeswitch 才變網卡
# 注意：OpenWrt 只有 usb-modeswitch 一個套件（data 已內含），
#       沒有獨立的 usb-modeswitch-data（實測 feed 裡查不到）。
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
# LuCI 的協定頁面（不然新增介面時選不到）
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-mbim=y
# 註：luci-i18n-proto-* 系列在 25.12 feed 裡不存在（實測），不要加。

# ---- 5. USB 序列埠（console / 偵錯，順手帶上）----
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
